{
    "name": "intersession-grid-cnn",
    "project": "intersession-6gest-final",
    "K": 1,
    "num_epochs": 2,
    "norm": 0,
    "lr": 0.001,
    "p_input": 0.0,
    "scheduler": {
        "def": "torch.optim.lr_scheduler.MultiStepLR",
        "params": {
            "milestones": [],
            "gamma": 0.1
        }
    },
    "batch_size": 128,
    "momentum": 0,
    "weight_decay": 0,
    "network": "CapgMyoNet",
    "dataset": "csl",
    "emg_tensorizer": "CSLData",
    "Trms": 0.25,
    "adaptation": "spatial-adaptation",
    "adaptation_params": {
        "xshift": true,
        "yshift": true,
        "rot_theta": true,
        "xscale": true,
        "yscale": true,
        "xshear": true,
        "yshear": true
    },
    "real_baseline": "mean-square",
    "corrective_gain": false,
    "learnable_baseline": false,
    "adabatch": false,
    "gest_subset": [7,8,12,20,22,23],
    "adapt_gest_subset": null,
    "circular": false,
    "median-filter": true
}