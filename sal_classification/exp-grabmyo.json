{
    "name": "intersession-grabmyo",
    "project": "simulation-new",
    "K": 1,
    "num_epochs": 1,
    "norm": 0,
    "lr": 0.001,
    "p_input": 0.0,
    "scheduler": {
        "def": "torch.optim.lr_scheduler.MultiStepLR",
        "params": {
            "milestones": [],
            "gamma": 0.1
        }
    },
    "batch_size": 128,
    "momentum": 0,
    "weight_decay": 0,
    "network": "LogisticRegressor",
    "dataset": "grabmyo-forearm",
    "emg_tensorizer": "GrabmyoData",
    "Trms": 0.25,
    "adaptation": "spatial-adaptation",
    "adaptation_params": {
        "xshift": true,
        "yshift": false,
        "rot_theta": false,
        "xscale": false,
        "yscale": false,
        "xshear": false,
        "yshear": false
    },
    "real_baseline": "mean-square",
    "corrective_gain": true,
    "learnable_baseline": false,
    "adabatch": false,
    "gest_subset": [10,11,12,13,14,15],
    "circular": true,
    "median-filter": false
}