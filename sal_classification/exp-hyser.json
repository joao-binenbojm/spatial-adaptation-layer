{
    "name": "intersession-hyser-test",
    "project": "simulation-new",
    "K": 1,
    "num_epochs": 15,
    "norm": 0,
    "lr": 0.001,
    "p_input": 0.5,
    "scheduler": {
        "def": "torch.optim.lr_scheduler.MultiStepLR",
        "params": {
            "milestones": [],
            "gamma": 0.1
        }
    },
    "batch_size": 128,
    "momentum": 0,
    "weight_decay": 0,
    "network": "LogisticRegressor",
    "dataset": "hyser",
    "emg_tensorizer": "HyserData",
    "Trms": 0.25,
    "adaptation": "spatial-adaptation",
    "adaptation_params": {
        "xshift": true,
        "yshift": true,
        "rot_theta": true,
        "xscale": true,
        "yscale": true,
        "xshear": true,
        "yshear": true
    },
    "real_baseline": true,
    "learnable_baseline": false,
    "adabatch": false,
    "corrective_gain": false,
    "gest_subset": [5,6,7,8,9,10, 29,30],
    "circular": false,
    "median-filter": true
}